	author = {Yang, Nian and Liu, Yanchu and Cui, Zhenyu},
	urldate = {2025-11-17},
	date = {2017-06-01},
	keywords = {{SABR} model, Closed-form approximation, Continuously monitored barrier option, Stochastic volatility, Survival density},
}

