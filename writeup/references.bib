@article{breeden_path-dependent_1997,
	title = {A path-dependent approach to security valuation with application to interest rate contingent claims},
	volume = {21},
	issn = {0378-4266},
	url = {https://www.sciencedirect.com/science/article/pii/S0378426696000623},
	doi = {10.1016/S0378-4266(96)00062-3},
	abstract = {The last two decades have witnessed a tremendous growth in the volume of assets and liabilities whose cash flows depend, in a variety of ways, on the path of interest rates. Some of these, including floating-rate notes and swap agreements, contractually base cash flows on current and past interest rates and contain caps, floors, and other, more complex features. Others, including mortgages, many corporate bonds, and time deposits, are fixed-rate instruments that contain embedded options, such as those to prepay, call, or withdrawal. The irregular exercise of these options causes cash flows to vary as time proceeds and interest rates rise or fall. This paper develops a state-contingent claims technique for valuing such securities. It is derived from the option-based model of Breeden and Litzenberger (1978) using the transition matrix approach of Banz and Miller (1978). Particular attention is paid to valuing so-called path-dependent securities whose contemporaneous cash flows depend on the historical path of interest rates as well as their current level. A detailed example is provided in which an adjustable-rate mortgage is valued under a variety of economic and security specific assumptions.},
	pages = {541--562},
	number = {4},
	journaltitle = {Journal of Banking \& Finance},
	shortjournal = {Journal of Banking \& Finance},
	author = {Breeden, Douglas T. and Gilkeson, James H.},
	urldate = {2025-12-02},
	date = {1997-04-01},
	keywords = {Embedded options, Interest rate contingent claims, Mortgage valuation, Path-dependent pricing},
}

