@article{minnick_why_2014,
	title = {Why are Stock Splits Declining?},
	volume = {43},
	issn = {0046-3892},
	url = {https://www.jstor.org/stable/43280171},
	doi = {10.1111/fima.12024},
	abstract = {The percentage of firms undertaking stock splits has fallen from a peak of 23\% in 1982 to less than 1\% in 2009. Controlling for time trends and other economic determinants, the declining incidence of stock splits is significantly associated with a drop in household investors' equity holdings and with a rise in household income. We also report a decline in the size of split factors that is associated with an increase in institutional ownership of equity and with an increase in household income. Collectively, the evidence is consistent with firms responding rationally to changes in investor characteristics.},
