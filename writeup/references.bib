@article{amin_inferring_1997,
	title = {Inferring Future Volatility from the Information in Implied Volatility in Eurodollar Options: A New Approach},
	volume = {10},
	issn = {0893-9454},
	url = {https://www.jstor.org/stable/2962349},
	doi = {10.1093/rfs/10.2.333},
	shorttitle = {Inferring Future Volatility from the Information in Implied Volatility in Eurodollar Options},
	abstract = {We study the information content of implied volatility from several volatility specifications of the Heath-Jarrow-Morton (1992) ({HJM}) models relative to popular historical volatility models in the Eurodollar options market. The implied volatility from the {HJM} models explains much of the variation of realized interest rate volatility over both daily and monthly horizons. The implied volatility dominates the {GARCH} terms, the Glosten et al. (1993) type asymmetric volatility terms, and the interest rate level. However, it cannot explain that the impact of interest rate shocks on the volatility is lower when interest rates are low than when they are high.},
