@article{chen_malliavin_2007,
	title = {Malliavin Greeks without Malliavin calculus},
	volume = {117},
	issn = {0304-4149},
	url = {https://www.sciencedirect.com/science/article/pii/S0304414907000877},
	doi = {10.1016/j.spa.2007.03.012},
	series = {Recent Developments in Mathematical Finance},
	abstract = {We derive and analyze Monte Carlo estimators of price sensitivities (“Greeks”) for contingent claims priced in a diffusion model. There have traditionally been two categories of methods for estimating sensitivities: methods that differentiate paths and methods that differentiate densities. A more recent line of work derives estimators through Malliavin calculus. The purpose of this article is to investigate connections between Malliavin estimators and the more traditional and elementary pathwise method and likelihood ratio method. Malliavin estimators have been derived directly for diffusion processes, but implementation typically requires simulation of a discrete-time approximation. This raises the question of whether one should discretize first and then differentiate, or differentiate first and then discretize. We show that in several important cases the first route leads to the same estimators as are found through Malliavin calculus, but using only elementary techniques. Time-averaging of multiple estimators emerges as a key feature in achieving convergence to the continuous-time limit.},
	pages = {1689--1723},
	number = {11},
	journaltitle = {Stochastic Processes and their Applications},
	shortjournal = {Stochastic Processes and their Applications},
	author = {Chen, Nan and Glasserman, Paul},
	urldate = {2025-11-26},
	date = {2007-11-01},
	keywords = {Monte Carlo simulation, Likelihood ratio method, Malliavin calculus, Pathwise derivative method, Weak convergence},
}

