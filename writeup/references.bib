	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/j.1467-9965.1996.tb00112.x},
	keywords = {Callable bond, Green's function, numerical quadrature, orthogonal polynomials, series solutin of the partial differential equation to value a discount bond},
}

