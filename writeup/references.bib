@article{crisostomo_speed_2018,
	title = {Speed and biases of Fourier-based pricing choices: a numerical analysis},
	volume = {95},
	issn = {0020-7160},
	url = {https://doi.org/10.1080/00207160.2017.1322691},
	doi = {10.1080/00207160.2017.1322691},
	shorttitle = {Speed and biases of Fourier-based pricing choices},
	abstract = {We compare the {CPU} effort and pricing biases of seven Fourier-based implementations. Our analyses show that truncation and discretization errors significantly increase as we move away from the Black–Scholes–Merton framework. We rank the speed and accuracy of the competing choices, showing which methods require smaller truncation ranges and which are the most efficient in terms of sampling densities. While all implementations converge well in the Bates jump-diffusion model, Attari's formula is the only Fourier-based method that does not blow up for any Variance Gamma parameter values. In terms of speed, the use of strike vector computations significantly improves the computational burden, rendering both fast Fourier transforms ({FFT}) and plain delta-probability decompositions inefficient. We conclude that the multi-strike version of the {COS} method is notably faster than any other implementation, whereas the strike-optimized Carr Madan's formula is simultaneously faster and more accurate than the {FFT}, thus questioning its use.},
	pages = {1565--1582},
	number = {8},
	journaltitle = {International Journal of Computer Mathematics},
	author = {Crisóstomo, Ricardo},
	urldate = {2025-12-05},
	date = {2018-08-03},
	note = {Publisher: Taylor \& Francis
\_eprint: https://doi.org/10.1080/00207160.2017.1322691},
	keywords = {Option pricing, Fourier transforms, 30E10, 60H35, 65C20, 65T50, jump processes, pricing errors, speed comparisons},
}

