      \field{issn}{1350-486X}
      \field{journaltitle}{Applied Mathematical Finance}
      \field{month}{9}
      \field{note}{Publisher: Routledge \_eprint: https://doi.org/10.1080/13504869400000004}
      \field{number}{1}
      \field{shorttitle}{Stochastic equity volatility related to the leverage effect}
      \field{title}{Stochastic equity volatility related to the leverage effect: I equity volatility behaviour}
