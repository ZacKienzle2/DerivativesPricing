  shorttitle = {Chaos and {{Coherence}}},
  author = {Brody, Dorje C. and Hughston, Lane P.},
  date = {2004},
  journaltitle = {Proceedings: Mathematical, Physical and Engineering Sciences},
  volume = {460},
