@article{vanderzwaardHullWhiteModelVolatility2025,
  title = {On the {{Hull-White}} Model with Volatility Smile for {{Valuation Adjustments}}},
  author = {family=Zwaard, given=T., prefix=van der, useprefix=true and Grzelak, L. A. and Oosterlee, C. W.},
  date = {2025-10-03},
  journaltitle = {Quantitative Finance},
